# =====================================================================
# Altapete Solutions - Email Configuration (SMTP)
# =====================================================================
# To activate direct automated email sending to info@altapetesolutions.com,
# copy this file to `.env.local` and enter your SMTP server credentials:

SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@altapetesolutions.com
SMTP_PASS=your_smtp_password_here

# Target inbox for all website inquiries
CONTACT_EMAIL=info@altapetesolutions.com
